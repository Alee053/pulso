SERVER_PORT=8080

# Backend diagnostic logging level: INFO, WARN, ERROR, or OFF.
PULSO_LOG_LEVEL=INFO

# Backend database connection for the root `docker compose` stack. Never
# commit a real hosted password.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:54322/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Supabase Auth. The repository Compose stack uses a fixed HS256 fixture only
# for local development. Never reuse it in a hosted environment.
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_JWK_SET_URI=
SUPABASE_JWT_SECRET=pulso-local-jwt-secret-change-me-32-chars

# Browser origin allowed to call the backend API.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Local invitation email delivery through the Mailpit service in compose.yaml.
PULSO_SMTP_PORT=54325
SMTP_HOST=localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
PULSO_INVITATION_FRONTEND_URL=http://localhost:4200
PULSO_INVITATION_FROM=no-reply@pulso.local
