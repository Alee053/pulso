SERVER_PORT=8080

# Backend database connection for the root `docker compose` stack. Never
# commit a real hosted password.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:54322/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Supabase Auth. The repository Compose stack uses a fixed HS256 fixture only
# for local development. Never reuse it in a hosted environment.
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_JWK_SET_URI=
SUPABASE_JWT_SECRET=pulso-local-jwt-secret-change-me-32-chars

# Browser origin allowed to call the backend API.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Optional API rule overrides. Defaults are defined in
# backend/src/main/resources/application.yml. Invalid values stop backend startup.
PULSO_DISCOVERY_DEFAULT_OFFSET=0
PULSO_DISCOVERY_DEFAULT_LIMIT=20
PULSO_DISCOVERY_MAX_LIMIT=50
PULSO_DISCOVERY_MAX_OFFSET=100000
PULSO_CATALOGS_MAX_ITEMS_PER_CATALOG=500
PULSO_PREFERENCES_MAX_ITEMS_PER_FIELD=10
PULSO_PREFERENCES_MAX_TOKEN_LENGTH=40
PULSO_PREFERENCES_SECTOR_ID_MAX_LENGTH=120
PULSO_PROFILE_DISPLAY_NAME_MAX_LENGTH=120
PULSO_PROFILE_AVATAR_PATH_MAX_LENGTH=500
PULSO_PROFILE_SHORT_BIO_MAX_LENGTH=500
PULSO_PROFILE_CITY_MAX_LENGTH=120
PULSO_PROFILE_DEPARTMENT_MAX_LENGTH=120
PULSO_PROJECT_SLUG_MIN_LENGTH=2
PULSO_PROJECT_SLUG_MAX_LENGTH=120
PULSO_PROJECT_NAME_MAX_LENGTH=160
PULSO_PROJECT_TAGLINE_MAX_LENGTH=240
PULSO_PROJECT_DESCRIPTION_MAX_LENGTH=5000
PULSO_PROJECT_CITY_MAX_LENGTH=120
PULSO_PROJECT_STAGE_TOKEN_MAX_LENGTH=40
PULSO_PROJECT_INVITEE_EMAIL_MAX_LENGTH=254
