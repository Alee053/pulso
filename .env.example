SERVER_PORT=8080

# Backend database connection. For local Supabase, run `pnpm db:status` and use
# the local DB URL shown there. Never commit a real hosted password.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:54322/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Supabase Auth. The current local CLI exposes an ES256 JWKS endpoint. The
# shared secret remains an explicit fallback for legacy/local HS256 tokens.
# To use the fallback, clear SUPABASE_JWT_JWK_SET_URI before setting the secret.
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_JWK_SET_URI=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# Browser origin allowed to call the backend API.
CORS_ALLOWED_ORIGINS=http://localhost:4200
