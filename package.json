{
  "name": "pulso",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.15.0 <25 || >=26.0.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @pulso/frontend dev",
    "start": "pnpm --filter @pulso/frontend start",
    "build": "pnpm --filter @pulso/frontend build",
    "preview": "pnpm --filter @pulso/frontend preview",
    "db:up": "pnpm exec supabase --workdir database start",
    "db:down": "pnpm exec supabase --workdir database stop",
    "db:reset": "pnpm exec supabase --workdir database db reset --local",
    "db:push": "pnpm exec supabase --workdir database db push --linked",
    "db:lint": "pnpm exec supabase --workdir database db lint --local",
    "db:test": "pnpm exec supabase --workdir database test db --local",
    "db:status": "pnpm exec supabase --workdir database status",
    "db:verify": "sh ./scripts/verify-local-supabase.sh",
    "db:compose:up": "docker compose up -d",
    "db:compose:down": "docker compose down",
    "db:compose:seed": "docker compose run --rm migrator",
    "db:compose:status": "docker compose ps",
    "db:migration:new": "pnpm exec supabase --workdir database migration new",
    "db:push:dry-run": "pnpm exec supabase --workdir database db push --linked --dry-run",
    "backend:run": "sh ./scripts/run-backend.sh",
    "backend:verify": "sh ./scripts/verify-local-backend.sh",
    "auth:verify": "sh ./scripts/verify-local-auth.sh",
    "smoke:verify": "sh ./scripts/verify-local-smoke.sh",
    "backend:test": "sh ./backend/gradlew -p backend test",
    "backend:build": "sh ./backend/gradlew -p backend build"
  },
  "devDependencies": {
    "supabase": "2.116.0"
  }
}
