{
  "name": "pulso",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.15.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @pulso/frontend dev",
    "build": "pnpm --filter @pulso/frontend build",
    "preview": "pnpm --filter @pulso/frontend preview",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "backend:run": "./backend/gradlew -p backend bootRun",
    "backend:test": "./backend/gradlew -p backend test",
    "backend:build": "./backend/gradlew -p backend build"
  }
}
